POSTGRES_DB=marketguard
POSTGRES_USER=marketguard
POSTGRES_PASSWORD=

MARKETGUARD_ADMIN_USERNAME=operator
MARKETGUARD_ADMIN_PASSWORD=
MARKETGUARD_SECURITY_ENABLED=true
MARKETGUARD_OPERATOR_TOKEN=
MARKETGUARD_ALLOWED_ORIGINS=http://localhost:5050
HOST_PORT=5050

COLLECTOR_ENABLED=false
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 감사 로그 보존 기간. 0이면 지우지 않음(기본). 설정하면 최소 1일, 예: 365d
AUDIT_RETENTION=0

# 전 종목 운영(선택). CSV는 MARKETGUARD_DATA_DIR(기본 ./data)에 두고 컨테이너 안 경로(/data/...)로 지정한다.
# 비우면 시연용 기본 35종목만 스캔하며, 이때는 시장·업종 대비 결과가 거의 계산되지 않는다.
MARKETGUARD_DATA_DIR=./data
SCAN_SYMBOLS_FILE=
OUTCOME_SECTORS_FILE=
